PORT=3001
KEYCLOAK_ISSUER=http://localhost:8080/realms/company-iam
API_AUDIENCE=employee-api
FRONTEND_ORIGIN=http://localhost:5173
SECURITY_FRONTEND_ORIGIN=http://localhost:5174
SECURITY_API_AUDIENCE=security-api
# Optional internal realm URL for a trusted loopback connection behind the HTTPS gateway.
KEYCLOAK_INTERNAL_ISSUER=http://127.0.0.1:8080/realms/company-iam
AUDIT_LOG_FILE=data/audit.jsonl
# Week 2 uses a transactional SQLite database; week-1 JSONL remains an archive.
ATTENDANCE_DB=data/attendance.sqlite
KEYCLOAK_ADMIN_CLIENT_ID=attendance-control
# Filled automatically by python scripts/setup_week2.py
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Week 5: no pruning until an operator explicitly chooses a retention period.
AUDIT_RETENTION_DAYS=0
KEYCLOAK_EVENTS_RETENTION_DAYS=7
# Optional isolated instance: IAM_BACKEND_ENV selects this file at process start.
# STAFF_FILE=data/staff.json
# Week 6: filled only by the explicit setup_week6.py; empty keeps LDAP unconfigured.
DIRECTORY_COMPONENT_ID=
DIRECTORY_SYNC_INTERVAL_SECONDS=300
# Week 8: private server-to-server API; never expose this token to Vite.
AUDIT_SERVICE_URL=
AUDIT_SERVICE_TOKEN=
