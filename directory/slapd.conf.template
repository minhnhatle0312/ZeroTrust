include /etc/ldap/schema/core.schema
include /etc/ldap/schema/cosine.schema
include /etc/ldap/schema/inetorgperson.schema
pidfile /run/nhip-ldap/slapd.pid
argsfile /run/nhip-ldap/slapd.args
modulepath /usr/lib/ldap
moduleload back_mdb
TLSCACertificateFile /run/nhip-ldap/ca.crt
TLSCertificateFile /run/nhip-ldap/server.crt
TLSCertificateKeyFile /run/nhip-ldap/server.key
TLSProtocolMin 3.3
TLSVerifyClient never
disallow bind_anon
database mdb
maxsize 1073741824
suffix "dc=company,dc=local"
rootdn "cn=admin,dc=company,dc=local"
rootpw @ADMIN_HASH@
directory /var/lib/ldap
index objectClass eq
index uid,cn,mail,entryUUID eq
index member eq
index employeeType eq

# The root DN bypasses ACL for controlled CLI maintenance. Service binds cannot
# read hashes or write attributes. Disabled people cannot perform password bind.
access to dn.base=""
  by * read
access to dn.base="cn=Subschema"
  by * read
access to dn.subtree="ou=people,dc=company,dc=local" filter=(employeeType=disabled) attrs=userPassword
  by * none
access to attrs=userPassword
  by anonymous auth
  by self auth
  by * none
access to dn.subtree="dc=company,dc=local"
  by dn.exact="cn=keycloak-reader,ou=services,dc=company,dc=local" read
  by self read
  by * none
