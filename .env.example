# Run python scripts/init_env.py to create missing .env files and random passwords.
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
TEST_ADMIN01_PASSWORD=
TEST_MANAGER01_PASSWORD=
TEST_EMPLOYEE01_PASSWORD=
TEST_AUDITOR01_PASSWORD=
TEST_EMPLOYEE02_PASSWORD=
TEST_MANAGER02_PASSWORD=
# Canonical public Keycloak URL; configure_network.py updates the local .env.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
