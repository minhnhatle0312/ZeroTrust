# Copy to deploy/.local/production-like.env and fill your own independent values.
POSTGRES_DB=keycloak_week5
POSTGRES_USER=keycloak_week5
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
WEEK5_PUBLIC_URL=https://localhost:9443
# IP/CIDR as seen by Keycloak for the host reverse proxy; do not use 0.0.0.0/0.
WEEK5_TRUSTED_PROXIES=
